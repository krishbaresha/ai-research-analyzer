# AI Research Analyzer — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose secrets to client code.

# Server-Side OpenAI API Configuration (DO NOT use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Document Upload & Processing Limits (in Bytes)
# Default: 10485760 (10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Firebase Cloud Firestore Database Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
