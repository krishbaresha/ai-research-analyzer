# AI Research Analyzer — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose secrets to client code.

# Server-Side Groq API Configuration (DO NOT use NEXT_PUBLIC_ prefix)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (Configurable; defaults to verified OpenAI GPT-OSS on Groq)
# Flagship: openai/gpt-oss-120b
# Compact / Fallback: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Document Upload & Processing Limits (in Bytes)
# Default: 10485760 (10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Persistence / Future Supabase Integration (Phase 6)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
